{
  "permissions": {
    "ask": [
      "Edit(/packages/risk-engine/**)",
      "Edit(/packages/trading-engine/**)",
      "Edit(/packages/shared/src/execution-gate.ts)",
      "Edit(/packages/shared/src/strategy.ts)",
      "Edit(/packages/market-data/src/*venue*)",
      "Edit(/packages/market-data/src/*broker*)",
      "Edit(/packages/market-data/src/execution-*)",
      "Edit(/packages/evolution/src/promotion.ts)",
      "Edit(/.github/workflows/**)",
      "Bash(*LIVE_MONEY*)",
      "PowerShell(*LIVE_MONEY*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-trading-paths.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
