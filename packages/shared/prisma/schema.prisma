generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  createdAt    DateTime @default(now())
}

model EngineControl {
  id               String   @id @default("primary")
  status           String
  flattenRequested Boolean  @default(false)
  config           Json
  activeStrategy   Json?
  /// Non-strategy runtime: fairnessCursor, last diagnostics (§15/§16). Not StrategyConfig.
  runtimeState     Json?
  updatedAt        DateTime @updatedAt
  updatedBy        String?
}

model PaperAccount {
  id                    String         @id @default("primary")
  cashUsd               Decimal        @db.Decimal(24, 8)
  startingBalanceUsd    Decimal        @db.Decimal(24, 8)
  highWaterMarkUsd      Decimal?       @db.Decimal(24, 8)
  sessionStartEquityUsd Decimal?       @db.Decimal(24, 8)
  sessionStartedAt      DateTime?
  /// Lowest known equity this Europe/London day; latches the daily loss limit (ASCEND-00 F1)
  sessionLowEquityUsd   Decimal?       @db.Decimal(24, 8)
  /// FIXTURE | REPLAY | MARKET_DATA_PAPER | EXTERNAL_DEMO — isolation boundary
  tradingEnvironment    String         @default("MARKET_DATA_PAPER")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  positions             Position[]
  orders                Order[]
  ledger                LedgerEntry[]
}

model MarketObservation {
  id             String    @id @default(cuid())
  ingestJobId    String
  source         String
  chainId        String
  pairAddress    String
  dexId          String
  url            String?
  baseAddress    String
  baseSymbol     String
  baseName       String
  quoteAddress   String
  quoteSymbol    String
  priceUsd       Decimal?  @db.Decimal(24, 8)
  liquidityUsd   Decimal?  @db.Decimal(24, 8)
  volume24hUsd   Decimal?  @db.Decimal(24, 8)
  volume5mUsd    Decimal?  @db.Decimal(24, 8)
  priceChangeM5  Decimal?  @db.Decimal(16, 6)
  priceChangeH1  Decimal?  @db.Decimal(16, 6)
  priceChangeH24 Decimal?  @db.Decimal(16, 6)
  txnsM5Buys     Int?
  txnsM5Sells    Int?
  pairCreatedAt  DateTime?
  fdvUsd         Decimal?  @db.Decimal(24, 8)
  marketCapUsd   Decimal?  @db.Decimal(24, 8)
  freshness      String
  /// LIVE_FEED | DELAYED_FEED | FIXTURE_SEQUENCE | REPLAY_STORE | PROVIDER_DEMO | SANDBOX_BROKER
  dataOrigin     String?
  /// Owning trading environment for isolation (never mix fixture into paper metrics).
  tradingEnvironment String?
  /// Provider event time when known; else null (do not invent).
  eventTime      DateTime?
  receivedAt     DateTime
  raw            Json
  createdAt      DateTime  @default(now())

  @@unique([ingestJobId, pairAddress])
  @@index([pairAddress, receivedAt])
  @@index([pairAddress, eventTime])
  @@index([tradingEnvironment, receivedAt])
  @@index([receivedAt])
}

model WatchlistEntry {
  id           String   @id @default(cuid())
  pairAddress  String
  baseAddress  String
  baseSymbol   String
  quoteAddress String
  quoteSymbol  String
  dexId        String
  source       String
  score        Decimal  @db.Decimal(16, 6)
  rank         Int
  reasonCodes  String[]
  observationId String?
  cycleId      String?
  observedAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([pairAddress])
  @@index([score, rank])
  @@index([observedAt])
}

model SecurityAssessment {
  id                         String   @id @default(cuid())
  tokenAddress               String
  category                   String
  confidence                 Decimal  @db.Decimal(8, 6)
  reasonCodes                String[]
  mintAuthority              String
  freezeAuthority            String
  transferRestricted         Boolean?
  holderConcentrationTop10Pct Decimal? @db.Decimal(16, 6)
  suspiciousDeployer         Boolean?
  liquidityFragile           Boolean?
  largeWalletMove            Boolean?
  fraudIndicators            String[]
  source                     String
  stale                      Boolean  @default(false)
  fields                     Json
  fetchedAt                  DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([tokenAddress])
  @@index([category, updatedAt])
}

model EquitySnapshot {
  id               String   @id @default(cuid())
  /// Account / environment isolation for REPLAY vs paper metrics.
  accountId        String   @default("primary")
  cycleId          String?
  cashUsd          Decimal  @db.Decimal(24, 8)
  equityUsd        Decimal? @db.Decimal(24, 8)
  unrealizedPnlUsd Decimal? @db.Decimal(24, 8)
  realizedPnlUsd   Decimal  @db.Decimal(24, 8)
  highWaterMarkUsd Decimal? @db.Decimal(24, 8)
  exposureUsd      Decimal? @db.Decimal(24, 8)
  valuation        String
  feesUsd          Decimal  @db.Decimal(24, 8)
  metrics          Json
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([cycleId])
  @@index([accountId, createdAt])
}

model ResearchProposal {
  id              String   @id @default(cuid())
  status          String
  parameterPatch  Json
  rationale       String
  walkForward     Json?
  metrics         Json?
  promoted        Boolean  @default(false)
  modelVersion    String?
  createdAt       DateTime @default(now())
  evaluatedAt     DateTime?
  approvedAt      DateTime?

  @@index([status, createdAt])
}

/// Frozen strategy snapshot for lab comparison. Never auto-graduates to real money (no real-money venue).
model StrategyVersion {
  id        String        @id @default(cuid())
  name      String
  version   Int
  parentId  String?
  config    Json
  notes     String?
  status    String        @default("DRAFT")
  createdBy String?
  createdAt DateTime      @default(now())
  runs      BacktestRun[]

  @@unique([name, version])
  @@index([status, createdAt])
}

model BacktestRun {
  id                String               @id @default(cuid())
  strategyVersionId String?
  status            String
  label             String?
  params            Json
  assumptions       Json
  dataQuality       Json?
  metrics           Json?
  baselines         Json?
  validation        Json?
  releaseGate       Json?
  equityCurve       Json?
  reportHtml        String?
  error             String?
  /// PRE_SANDBOX_FIX for rows created before the streaming fd-3 sandbox (audit C1/C2); never promotion evidence.
  sandboxEra        String               @default("STREAMING_FD3")
  startedAt         DateTime
  finishedAt        DateTime?
  createdAt         DateTime             @default(now())
  strategyVersion   StrategyVersion?     @relation(fields: [strategyVersionId], references: [id])
  trades            BacktestTrade[]
  experiments       ExperimentMetrics[]
  oracleReviews     OracleReview[]

  @@index([status, createdAt])
  @@index([strategyVersionId])
}

model BacktestTrade {
  id            String      @id @default(cuid())
  runId         String
  pairAddress   String
  baseSymbol    String
  side          String
  intent        String
  qty           Decimal     @db.Decimal(24, 8)
  priceUsd      Decimal     @db.Decimal(24, 8)
  feeUsd        Decimal     @db.Decimal(24, 8)
  slippageBps   Decimal     @db.Decimal(16, 6)
  notionalUsd   Decimal     @db.Decimal(24, 8)
  pnlUsd        Decimal?    @db.Decimal(24, 8)
  eventAt       DateTime
  observationId String?
  reasonCodes   String[]
  meta          Json?
  run           BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, eventAt])
  @@index([pairAddress, eventAt])
}

model ExperimentMetrics {
  id         String       @id @default(cuid())
  runId      String?
  proposalId String?
  kind       String
  sampleSize Int
  observed   Boolean
  payload    Json
  createdAt  DateTime     @default(now())
  run        BacktestRun? @relation(fields: [runId], references: [id])

  @@index([kind, createdAt])
  @@index([runId])
}

model ObservabilityEvent {
  id        String   @id @default(cuid())
  category  String
  name      String
  value     Decimal? @db.Decimal(24, 8)
  unit      String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([name, createdAt])
}

/// ORACLE is advisory only. Human approval required; never executes trades or mutates RUNNING config.
model OracleReview {
  id           String       @id @default(cuid())
  runId        String?
  proposalId   String?
  status       String
  summary      String
  weaknesses   Json
  suggestions  Json
  readiness    String
  provider     String
  modelVersion String?
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime     @default(now())
  run          BacktestRun? @relation(fields: [runId], references: [id])

  @@index([status, createdAt])
  @@index([runId])
}

model CycleRun {
  id               String    @id
  trigger          String
  status           String
  stage            String
  dataState        String
  error            String?
  operator         Json?
  observationCount Int       @default(0)
  orderCount       Int       @default(0)
  startedAt        DateTime
  finishedAt       DateTime?
  /// Durable pinned ExecutionContext at cycle creation (D01) — stages must not re-resolve live config.
  accountId           String?
  tradingEnvironment  String?
  dataMode            String?
  configRevision      String?
  strategyRevision    String?
  riskRevision        String?
  pinnedContext       Json?
  /// Executor phase durations in ms (settle, plan, reconcile, admit, protect, transaction) — audit H3.
  executorTimings     Json?

  @@index([status, startedAt])
  @@index([startedAt])
  @@index([accountId, startedAt])
  @@index([tradingEnvironment, startedAt])
}

/// Audit F1: the single immutable plan computed for a cycle (UPDATE refused by trigger).
model CyclePlan {
  cycleId   String   @id
  plannedAt DateTime
  /// { decisions, orders, watchlist, intentOutcomes } as computed by planCycle at plannedAt.
  plan      Json
  createdAt DateTime @default(now())
}

model AgentDecision {
  id           String   @id @default(cuid())
  cycleId      String
  agent        String
  modelVersion String
  pairAddress  String   @default("")
  decision     String
  confidence   Decimal  @db.Decimal(8, 6)
  reasonCodes  String[]
  input        Json
  output       Json
  inputSource  String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@unique([cycleId, agent, pairAddress])
  @@index([createdAt])
  @@index([agent, createdAt])
}

model Order {
  id              String    @id @default(cuid())
  clientOrderId   String    @unique
  cycleId         String
  accountId       String
  pairAddress     String
  baseSymbol      String
  side            String
  intent          String
  status          String
  qty             Decimal   @db.Decimal(24, 8)
  filledQty       Decimal   @default(0) @db.Decimal(24, 8)
  reasonCodes     String[]
  rejectReason    String?
  /// Observation that informed the admission decision (may predate eligibility).
  observationId   String?
  decisionObservationId String?
  /// Observation used for the economic fill (at/after eligibility).
  fillObservationId String?
  executionMode   String    @default("PAPER")
  venue           String    @default("PAPER")
  instrumentId    String?
  strategyVersion String?
  /// Durable concurrent StrategyInstance owner (§5/§8) — not only a version stamp.
  strategyInstanceId String?
  /// Canonical TradeIntent that produced this order (null for legacy rows).
  intentId        String?
  /// Who owns the economic consequence: STRATEGY | OPERATOR | PROTECTION | ACCOUNT_FLATTEN | NET_CLOSE | LEGACY.
  ownerScope      String    @default("LEGACY")
  /// External venue order id (SANDBOX). Null for local PAPER.
  brokerOrderId   String?
  /// LOCAL | PRE_SUBMIT | SUBMITTING | ACKED | UNKNOWN | TERMINAL — durable submission outbox state.
  submissionState String    @default("LOCAL")
  submitAttempts  Int       @default(0)
  nextSyncAt      DateTime?
  lastBrokerSyncAt DateTime?
  lastBrokerStatus String?
  lastSubmitError String?
  /// NONE | REQUESTED | PENDING | CONFIRMED | REJECTED | FILLED_DURING_CANCEL | UNKNOWN
  cancelState     String    @default("NONE")
  cancelRequestedAt DateTime?
  submittedAt     DateTime  @default(now())
  eligibleAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  account         PaperAccount @relation(fields: [accountId], references: [id])
  fills           Fill[]

  @@index([createdAt])
  @@index([cycleId])
  @@index([status, eligibleAt])
  @@index([executionMode, venue])
  @@index([strategyInstanceId])
  @@index([accountId, createdAt])
  @@index([accountId, submissionState])
  @@index([intentId])
  @@index([brokerOrderId])
}

model Fill {
  id            String   @id @default(cuid())
  orderId       String
  /// Local simulation observation. Null for broker executions (never fabricated).
  observationId String?
  /// LOCAL_SIM | BROKER
  source        String   @default("LOCAL_SIM")
  /// Broker execution/activity id — dedupe key with orderId.
  brokerExecutionId String?
  executedAt    DateTime?
  currency      String   @default("USD")
  /// True when fee is known (local model or broker-reported). False = fee unknown, feeUsd stored as 0 and labelled.
  feeKnown      Boolean  @default(true)
  pairAddress   String
  side          String
  qty           Decimal  @db.Decimal(24, 8)
  priceUsd      Decimal  @db.Decimal(24, 8)
  notionalUsd   Decimal  @db.Decimal(24, 8)
  feeUsd        Decimal  @db.Decimal(24, 8)
  slippageBps   Decimal  @db.Decimal(16, 6)
  liquidityUsd  Decimal  @db.Decimal(24, 8)
  strategyInstanceId String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id])

  @@index([pairAddress, createdAt])
  @@index([strategyInstanceId])
  @@unique([orderId, brokerExecutionId])
}

model Position {
  id             String   @id @default(cuid())
  accountId      String
  pairAddress    String
  baseSymbol     String
  baseQty        Decimal  @db.Decimal(24, 8)
  avgCostUsd     Decimal  @db.Decimal(24, 8)
  realizedPnlUsd Decimal  @db.Decimal(24, 8)
  /// Current open-lot id; minted on 0→open, cleared on flat. Scopes protection + open meta (R01).
  lifecycleId    String?
  /// Primary opening instance when a single owner; multi-strategy uses StrategyAllocation (§8).
  strategyInstanceId String?
  updatedAt      DateTime @updatedAt
  account        PaperAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, pairAddress])
  @@index([accountId, lifecycleId])
  @@index([strategyInstanceId])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  accountId   String
  type        String
  amountUsd   Decimal  @db.Decimal(24, 8)
  affectsCash Boolean
  orderId     String?
  fillId      String?
  note        String
  createdAt   DateTime @default(now())
  account     PaperAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([type, createdAt])
}

/// Multi-market instrument registry (Solana pairs + equity indices, etc.).
model Instrument {
  id                     String   @id
  symbol                 String
  displayName            String
  venue                  String
  assetClass             String
  base                   String
  quote                  String
  tickSize               String
  lotSize                String
  session                String
  providerId             String
  providerSymbol         String
  executionCapabilities  String[]
  enabledByDefault       Boolean  @default(false)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  selections             MarketSelection[]

  @@index([assetClass, venue])
  @@index([providerId])
}

model MarketSelection {
  id           String     @id @default(cuid())
  instrumentId String
  enabled      Boolean
  updatedBy    String?
  updatedAt    DateTime   @updatedAt
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([instrumentId])
}

model Hypothesis {
  id               String   @id @default(cuid())
  title            String
  market           String
  instrumentIds    String[]
  conditions       String
  claimedAdvantage String
  entryRules       String
  exitRules        String
  riskRules        String
  rationale        String
  successCriteria  String
  failureModes     String
  status           String   @default("OPEN")
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
  @@index([market])
}

/// ASCEND-00 F6: append-only history of EngineControl.config, written by a database trigger on every
/// insert and config change. Updates and deletes are rejected.
model EngineConfigRevision {
  id              BigInt   @id @default(autoincrement())
  engineId        String
  /// INSERT | UPDATE (trigger) | BASELINE (migration backfill)
  source          String
  config          Json
  previousConfig  Json?
  changedKeys     String[] @default([])
  configHash      String
  actor           String?
  /// EngineControl.updatedAt after the change; matches CycleRun.configRevision for cycles planned on it
  engineUpdatedAt DateTime
  createdAt       DateTime @default(now())

  @@index([engineId, engineUpdatedAt])
}

model LifecycleAudit {
  id           String   @id @default(cuid())
  strategyId   String
  fromState    String
  toState      String
  actor        String
  evidence     Json
  evidenceHash String
  createdAt    DateTime @default(now())

  @@index([strategyId, createdAt])
  @@index([toState, createdAt])
}

model ExperimentReport {
  id              String   @id @default(cuid())
  hypothesisId    String
  strategyModuleId String
  strategyVersion String
  payload         Json
  contentHash     String
  signature       String
  approvalStatus  String   @default("PENDING")
  approvedBy      String?
  approvedAt      DateTime?
  /// COMPLETE | INCOMPLETE | LEGACY_INCOMPLETE — evidence columns are immutable (DB trigger).
  provenance      String   @default("LEGACY_INCOMPLETE")
  sourceHash      String?
  artifactHash    String?
  configHash      String?
  datasetHash     String?
  backtestRunId   String?
  /// PRE_SANDBOX_FIX for rows created before the streaming fd-3 sandbox (audit C1/C2); never promotion evidence.
  sandboxEra      String   @default("STREAMING_FD3")
  createdAt       DateTime @default(now())

  @@index([hypothesisId, createdAt])
  @@index([contentHash])
  @@index([artifactHash, configHash])
}

/// Persisted executable identity. Hash is computed server-side, never accepted from a client.
model StrategyArtifact {
  id              String   @id @default(cuid())
  /// BUILTIN_MODULE | COMPILED_SANDBOX
  kind            String
  moduleRef       String?
  moduleVersion   String
  sourceHash      String
  artifactHash    String   @unique
  runtimeLoadable Boolean  @default(false)
  meta            Json?
  /// PRE_SANDBOX_FIX for rows created before the streaming fd-3 sandbox (audit C1/C2); never promotion evidence.
  sandboxEra      String   @default("STREAMING_FD3")
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([moduleRef])
}

/// Operator review bound to one report + artifact + config. Insert-only (DB trigger).
model PromotionApproval {
  id                String   @id @default(cuid())
  reportId          String
  reportContentHash String
  artifactId        String
  artifactHash      String
  sourceHash        String
  configHash        String
  /// APPROVED | REJECTED
  decision          String
  reviewer          String
  notes             String?
  createdAt         DateTime @default(now())

  @@index([reportId, createdAt])
  @@index([artifactHash, configHash])
}

/// Every write of the primary paper slot. Insert-only (DB trigger); rollback is a new row.
model StrategyPromotion {
  id                     String   @id @default(cuid())
  /// VALIDATED | UNVALIDATED_PAPER_EXPERIMENT | ROLLBACK
  mode                   String
  /// VALIDATED | UNVALIDATED_EXPERIMENT | LEGACY_INCOMPLETE (state restored by rollback keeps its own label)
  validationStatus       String
  checks                 Json
  /// COMPLETE | INCOMPLETE
  provenance             String
  reportId               String?
  approvalId             String?
  artifactId             String?
  strategyId             String
  strategyVersion        String
  moduleRef              String?
  moduleVersion          String?
  sourceHash             String
  artifactHash           String
  configHash             String
  config                 Json
  activeStrategy         Json?
  previousPromotionId    String?
  previousActiveStrategy Json?
  previousConfig         Json
  rollbackOfId           String?
  deploymentEligible     Boolean  @default(false)
  liveEligible           Boolean  @default(false)
  operator               String
  label                  String?
  rationale              String?
  createdAt              DateTime @default(now())

  @@index([createdAt])
  @@index([artifactHash, configHash])
}

/// Forward paper outcome computed server-side from Orders/Fills stamped with a promoted identity.
model ForwardPaperResult {
  id               String   @id @default(cuid())
  promotionId      String
  artifactHash     String
  configHash       String
  windowStart      DateTime
  windowEnd        DateTime
  orderCount       Int
  closedTradeCount Int
  netPnlUsd        String?
  returnPct        String?
  closedPnls       Json
  method           String
  createdBy        String
  createdAt        DateTime @default(now())

  @@index([artifactHash, configHash, createdAt])
  @@index([promotionId])
}

model TradeMemory {
  id          String   @id @default(cuid())
  tradeId     String
  pairAddress String
  phase       String
  postExit    Boolean  @default(false)
  context     Json
  capturedAt  DateTime
  createdAt   DateTime @default(now())

  @@index([tradeId, phase])
  @@index([pairAddress, capturedAt])
  @@index([postExit, capturedAt])
}

model ModelUsageLog {
  id                  String   @id @default(cuid())
  agentOrTask         String
  endpointId          String
  provider            String
  model               String
  tier                String
  ok                  Boolean
  latencyMs           Int
  promptTokensEst     Int
  completionTokensEst Int
  costUsdEst          Decimal  @db.Decimal(16, 8)
  costKind            String   @default("ESTIMATED")
  provenance          String   @default("UNAVAILABLE")
  error               String?
  createdAt           DateTime @default(now())

  @@index([agentOrTask, createdAt])
  @@index([tier, createdAt])
}

model ResearchQueueItem {
  id           String   @id @default(cuid())
  kind         String
  priority     Int
  hypothesisId String?
  strategyId   String?
  status       String
  reason       String
  budgetUsd    Decimal  @db.Decimal(16, 8)
  fingerprint  String   @default("")
  retries      Int      @default(0)
  capability   String   @default("RECOMMEND_EXPERIMENT")
  provenance   String   @default("DETERMINISTIC_SUPERVISOR")
  aiDiscovery  Boolean  @default(false)
  failureStreak Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, priority])
  @@index([createdAt])
}

model AutonomyControl {
  id                         String   @id @default("primary")
  level                      Int      @default(1)
  realMoneyExecutionEnabled  Boolean  @default(false)
  allowUnreviewedCodeDeploy  Boolean  @default(false)
  allowRiskLimitMutation     Boolean  @default(false)
  maxResearchIterations      Int      @default(8)
  maxResearchBudgetUsd       Decimal  @db.Decimal(16, 8) @default(5)
  timeoutMs                  Int      @default(120000)
  updatedAt                  DateTime @updatedAt
  updatedBy                  String?
}

model RiskReservation {
  id                     String   @id @default(cuid())
  accountId              String
  mode                   String   @default("PAPER")
  clientOrderId          String
  status                 String
  cashUsd                Decimal  @db.Decimal(24, 8)
  exposureUsd            Decimal  @db.Decimal(24, 8)
  slots                  Int
  riskUsd                Decimal  @db.Decimal(24, 8)
  remainingCashUsd       Decimal  @db.Decimal(24, 8) @default(0)
  remainingExposureUsd   Decimal  @db.Decimal(24, 8) @default(0)
  remainingRiskUsd       Decimal  @db.Decimal(24, 8) @default(0)
  remainingSlots         Int      @default(0)
  /// Instance capacity owner — instance pending commitment = sum of HELD remainingCashUsd.
  strategyInstanceId     String?
  intentId               String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  events                 RiskReservationEvent[]

  @@unique([accountId, mode, clientOrderId])
  @@index([accountId, status])
  @@index([accountId, strategyInstanceId, status])
}

model RiskReservationEvent {
  id            String   @id @default(cuid())
  reservationId String
  accountId     String
  mode          String
  clientOrderId String
  type          String
  payload       Json
  createdAt     DateTime @default(now())
  reservation   RiskReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([reservationId, createdAt])
}

model ProtectionOrder {
  id                       String   @id @default(cuid())
  accountId                String
  positionKey              String
  ocoGroupId               String
  /// Open-lot lifecycle this protection covers (R01).
  lifecycleId              String?
  kind                     String
  origin                   String
  direction                String   @default("LONG")
  protectedQty             Decimal  @db.Decimal(24, 8) @default(0)
  remainingQty             Decimal  @db.Decimal(24, 8) @default(0)
  triggerPriceUsd          Decimal? @db.Decimal(24, 8)
  /// Last confirmed (acked) trigger — retained when amendment fails.
  confirmedTriggerPriceUsd Decimal? @db.Decimal(24, 8)
  /// Desired trigger during amend/submit (may diverge until ACK).
  desiredTriggerPriceUsd   Decimal? @db.Decimal(24, 8)
  trailPct                 Decimal? @db.Decimal(16, 6)
  extremePriceUsd          Decimal? @db.Decimal(24, 8)
  status                   String
  /// DESIRED_ONLY | SUBMITTED | ACKED | REJECTED | CANCELLED | UNKNOWN
  ackState                 String   @default("ACKED")
  claimWorkerId            String?
  strategyInstanceId       String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([ocoGroupId])
  @@index([positionKey, status])
  @@index([lifecycleId, status])
  @@index([status, updatedAt])
  @@index([accountId, status])
}

model ProtectionIntent {
  id          String    @id @default(cuid())
  accountId   String
  ocoGroupId  String
  legId       String
  status      String
  reason      String
  /// EXIT_RETRY | AMEND_RETRY | CANCEL_RETRY | RECONCILE_UNKNOWN (D07)
  kind        String    @default("EXIT_RETRY")
  /// Immutable lifecycle fence — retries must not close a reopened lot (D07).
  lifecycleId String?
  instrumentId String?
  attempts    Int       @default(0)
  retryAfter  DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, retryAfter])
  @@index([ocoGroupId])
  @@index([accountId, status, retryAfter])
  @@index([kind, status])
}

model StrategyInstance {
  id              String   @id @default(cuid())
  name            String
  version         String
  accountId       String
  instrumentIds   String[]
  timeframe       String   @default("M5")
  params          Json
  budgetUsd       Decimal  @db.Decimal(24, 8)
  health          String   @default("HEALTHY")
  status          String   @default("ACTIVE")
  /// Explicit module binding (builtin ref). Never derived from display name (§7).
  moduleRef       String?
  artifactHash    String?
  sourceHash      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, status])
  @@index([status, updatedAt])
  @@index([moduleRef])
}

/// Internal strategy allocation — separate from venue net position (§8).
model StrategyAllocation {
  id                 String   @id @default(cuid())
  accountId          String
  strategyInstanceId String
  instrumentId       String
  pairAddress        String
  lifecycleId        String?
  qty                Decimal  @db.Decimal(24, 8)
  avgCostUsd         Decimal  @db.Decimal(24, 8)
  realizedPnlUsd     Decimal  @db.Decimal(24, 8) @default(0)
  committedCapitalUsd Decimal @db.Decimal(24, 8) @default(0)
  /// Derived display mirror of HELD RiskReservation remainders for this instance+pair. Authority is RiskReservation.
  pendingCapitalUsd  Decimal  @db.Decimal(24, 8) @default(0)
  /// Quantity committed to in-flight exit orders (prevents concurrent oversell).
  reservedExitQty    Decimal  @db.Decimal(24, 8) @default(0)
  /// Cumulative fees attributed to this allocation.
  feesUsd            Decimal  @db.Decimal(24, 8) @default(0)
  /// STRATEGY | UNATTRIBUTED | LEGACY
  ownership          String   @default("STRATEGY")
  /// False when cost basis is unknown (unattributed/legacy remainder) — never reported as strategy performance.
  costBasisKnown     Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([accountId, strategyInstanceId, pairAddress])
  @@index([accountId, pairAddress])
  @@index([strategyInstanceId])
}

model OpportunityFunnelEvent {
  id           String   @id @default(cuid())
  /// Account / environment isolation — REPLAY funnel must not mix into paper.
  accountId    String   @default("primary")
  cycleId      String
  pairAddress  String
  instrumentId String?
  stage        String
  reasonCodes  String[]
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([cycleId])
  @@index([stage, createdAt])
  @@index([accountId, createdAt])
}

model DurableAlert {
  id        String    @id @default(cuid())
  /// Optional account scope — notifications only; does not own safety resolution (R06).
  accountId String?
  severity  String    @default("INFO")
  code      String
  message   String
  acked     Boolean   @default(false)
  payload   Json?
  createdAt DateTime  @default(now())
  ackedAt   DateTime?

  @@index([acked, createdAt])
  @@index([accountId, acked, createdAt])
}

/// Active safety controls independent of DurableAlert.acked (R06).
/// ACK of an alert never resolves these — only clean reconcile / explicit resolve path.
model AccountSafetyState {
  id          String    @id @default(cuid())
  accountId   String
  code        String
  /// ACTIVE | RESOLVED
  status      String
  detail      Json?
  activatedAt DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([accountId, code])
  @@index([accountId, status])
}

/// Canonical attributed intent (Stage 2). One row per independent economic intent.
model TradeIntent {
  id                 String    @id
  /// Deterministic identity: retries of the same intent collide here, independent owners never do.
  idempotencyKey     String    @unique
  cycleId            String
  accountId          String
  tradingEnvironment String
  executionMode      String    @default("PAPER")
  venue              String    @default("PAPER")
  /// STRATEGY | OPERATOR | PROTECTION | ACCOUNT_FLATTEN | NET_CLOSE | RECOVERY
  source             String
  strategyInstanceId String?
  moduleRef          String?
  strategyVersion    String?
  configHash         String?
  artifactHash       String?
  sourceHash         String?
  instrumentId       String
  pairAddress        String
  /// ENTER | EXIT | REDUCE | CLOSE_NET | FLATTEN
  action             String
  side               String
  requestedQty       Decimal?  @db.Decimal(24, 8)
  sizedQty           Decimal?  @db.Decimal(24, 8)
  sizedNotionalUsd   Decimal?  @db.Decimal(24, 8)
  observationId      String?
  observationAt      DateTime?
  reasonCodes        String[]
  /// PROPOSED | DEFERRED | REJECTED | ADMITTED | SUBMITTED | PENDING | FILLED | PARTIALLY_FILLED | CANCELLED | EXPIRED | UNKNOWN
  status             String
  statusReason       String?
  eligibleAt         DateTime?
  expiresAt          DateTime?
  clientOrderId      String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([accountId, createdAt])
  @@index([cycleId])
  @@index([accountId, status, createdAt])
  @@index([strategyInstanceId, createdAt])
}

/// Durable operator-visible recovery / discrepancy record (Stages 8, 11, 19).
model RecoveryCase {
  id            String    @id @default(cuid())
  /// Idempotent dedupe — repeated detection updates the same case.
  dedupeKey     String    @unique
  accountId     String
  /// ALLOCATION_SETTLEMENT | ALLOCATION_DRIFT | UNKNOWN_SUBMISSION | BROKER_DRIFT | FILL_INCOMPLETE | PROTECTION_GAP | CANCEL_UNKNOWN
  kind          String
  severity      String    @default("ERROR")
  pairAddress   String?
  strategyInstanceId String?
  orderId       String?
  fillId        String?
  clientOrderId String?
  detail        Json
  /// OPEN | RESOLVED
  status        String    @default("OPEN")
  resolution    String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resolvedAt    DateTime?

  @@index([accountId, status, createdAt])
  @@index([kind, status])
}

/// One reconciliation pass with explicit coverage (Stages 11, 18).
model ReconciliationRun {
  id          String    @id @default(cuid())
  accountId   String
  /// LOCAL_ALLOCATION | BROKER
  scope       String
  venue       String
  startedAt   DateTime
  completedAt DateTime?
  /// CLEAN | DRIFT | INCOMPLETE | FAILED
  status      String
  /// True only when every compared list was fully paginated.
  complete    Boolean   @default(false)
  coverage    Json
  differences Json
  createdAt   DateTime  @default(now())

  @@index([accountId, scope, startedAt])
}

/// ASCEND-01: one versioned historical series (source × instrument × interval). Research data only;
/// never read by the trading loop.
model HistoricalDataset {
  id             String    @id @default(cuid())
  sourceId       String
  instrumentKey  String
  /// e.g. SOLANA_POOL, EQUITY_ETF, FX_PAIR
  instrumentKind String
  /// Research cohort: LIQUID_MAJOR | ESTABLISHED_SOLANA | SPECULATIVE_SOLANA | INACTIVE | BROAD_ETF | MAJOR_FX
  cohort         String
  interval       String
  licence        Json
  /// Content hash of all accepted bars; recomputed after each import. Null until the first import.
  versionHash    String?
  barCount       Int       @default(0)
  firstOpenTime  DateTime?
  lastOpenTime   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bars HistoricalBar[]
  jobs HistoricalBackfillJob[]

  @@unique([sourceId, instrumentKey, interval])
  @@index([cohort])
}

/// Normalised OHLCV bar. `availableAt` (bar close) is the earliest time a decision may use it.
model HistoricalBar {
  datasetId   String
  openTime    DateTime
  availableAt DateTime
  open        Decimal  @db.Decimal(38, 18)
  high        Decimal  @db.Decimal(38, 18)
  low         Decimal  @db.Decimal(38, 18)
  close       Decimal  @db.Decimal(38, 18)
  volume      Decimal? @db.Decimal(38, 8)
  extra       Json?
  hash        String
  collectedAt DateTime

  dataset HistoricalDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict)

  @@id([datasetId, openTime])
  @@index([datasetId, availableAt])
}

/// A provider later returned different values for an already-stored bar. The original is kept.
model HistoricalBarRevision {
  id           String   @id @default(cuid())
  datasetId    String
  openTime     DateTime
  previousHash String
  newHash      String
  newValues    Json
  detectedAt   DateTime @default(now())

  @@index([datasetId, openTime])
}

/// Rejected provider rows, with the integrity reason. Never silently dropped.
model HistoricalBarRejection {
  id         String   @id @default(cuid())
  datasetId  String
  openTime   DateTime
  reason     String
  recordedAt DateTime @default(now())

  @@index([datasetId, reason])
}

/// Immutable record of each provider response: request (no secrets), payload hash, optional payload.
model HistoricalRawBatch {
  id          String   @id @default(cuid())
  jobId       String
  sourceId    String
  request     String
  fetchedAt   DateTime
  payloadHash String
  rowCount    Int
  payload     Json?

  @@index([jobId, fetchedAt])
}

model HistoricalBackfillJob {
  id                String    @id @default(cuid())
  datasetId         String
  windowStart       DateTime
  windowEnd         DateTime
  cursor            String?
  status            String
  attempts          Int       @default(0)
  rowsImported      Int       @default(0)
  rowsRejected      Int       @default(0)
  revisionsDetected Int       @default(0)
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  dataset HistoricalDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict)

  @@index([status])
}

/// ASCEND-03: one validation run of one strategy version on one historical dataset. Append-only.
model ResearchRun {
  id              String   @id @default(cuid())
  datasetId       String
  datasetVersion  String
  codeVersion     String
  strategyId      String
  strategyVersion String
  family          String
  config          Json
  verdict         String
  reasons         String[]
  evidence        String
  summary         Json
  createdAt       DateTime @default(now())

  trials ResearchTrial[]

  @@index([strategyId, createdAt])
  @@index([datasetId, createdAt])
  @@index([verdict])
}

/// Every configuration tried, failures included (the denominator for DSR and PBO). Append-only.
model ResearchTrial {
  id           String   @id @default(cuid())
  runId        String
  window       String
  fold         Int?
  params       Json
  startT       DateTime
  endT         DateTime
  bars         Int
  trades       Int
  netReturn    Float
  sharpe       Float?
  perBarSharpe Float?

  run ResearchRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId])
}

/// A strategy version may evaluate a dataset's final holdout once. The unique key enforces it.
model ResearchHoldoutAccess {
  id              String   @id @default(cuid())
  strategyId      String
  strategyVersion String
  datasetId       String
  runId           String
  consumedAt      DateTime @default(now())

  @@unique([strategyId, strategyVersion, datasetId])
}

/// ASCEND-08: kill switch and limits for the bounded autonomous research loop. A missing row means
/// the loop is disabled. Bounds are also enforced by CHECK constraints in the migration.
model ResearchLoopControl {
  id                       String   @id @default("primary")
  enabled                  Boolean  @default(false)
  maxExperimentsPerDay     Int      @default(2)
  maxConcurrentExperiments Int      @default(2)
  maxAttemptsPerExperiment Int      @default(3)
  tickRuntimeMs            Int      @default(120000)
  leaseMs                  Int      @default(600000)
  updatedAt                DateTime @updatedAt
  updatedBy                String?
}

/// ASCEND-08: one experiment of the research loop. `version` is bumped on every claim and transition
/// (optimistic concurrency); `leaseOwner`/`leaseExpiresAt` fence a claim to one tick.
model ResearchExperiment {
  id             String    @id @default(cuid())
  hypothesisId   String
  state          String    @default("OBSERVE")
  /// Stage the experiment returns to once BLOCKED_APPROVAL is cleared (FORGE | TEST | PAPER).
  blockedState   String?
  attempts       Int       @default(0)
  lastError      String?
  leaseOwner     String?
  leaseExpiresAt DateTime?
  version        Int       @default(0)
  /// Stage outputs (hypothesis restatement, forged source and hashes, measured metrics, report id).
  context        Json      @default("{}")
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  events    ResearchExperimentEvent[]
  approvals ResearchApproval[]

  @@index([state, leaseExpiresAt])
  @@index([hypothesisId])
  @@index([createdAt])
}

/// ASCEND-08: append-only transition log (DB trigger rejects UPDATE and DELETE).
model ResearchExperimentEvent {
  id           String   @id @default(cuid())
  experimentId String
  /// CREATED | TRANSITION | ATTEMPT_FAILED | LEASE_RECLAIMED | LEASE_LOST
  kind         String
  fromState    String?
  toState      String
  actor        String
  reason       String?
  evidence     Json
  evidenceHash String
  createdAt    DateTime @default(now())

  experiment ResearchExperiment @relation(fields: [experimentId], references: [id], onDelete: Restrict)

  @@index([experimentId, createdAt])
  @@index([kind, createdAt])
}

/// ASCEND-08: operator approval of one gated action for one experiment. Append-only (DB trigger);
/// valid only while approvedAt <= now < expiresAt. The research loop never writes this table.
model ResearchApproval {
  id           String   @id @default(cuid())
  experimentId String
  action       String
  approvedBy   String
  approvedAt   DateTime @default(now())
  expiresAt    DateTime
  note         String?

  experiment ResearchExperiment @relation(fields: [experimentId], references: [id], onDelete: Restrict)

  @@index([experimentId, action, expiresAt])
}
