generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  createdAt    DateTime @default(now())
}

model EngineControl {
  id               String   @id @default("primary")
  status           String
  flattenRequested Boolean  @default(false)
  config           Json
  updatedAt        DateTime @updatedAt
  updatedBy        String?
}

model PaperAccount {
  id                 String         @id @default("primary")
  cashUsd            Decimal        @db.Decimal(24, 8)
  startingBalanceUsd Decimal        @db.Decimal(24, 8)
  highWaterMarkUsd   Decimal?       @db.Decimal(24, 8)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  positions          Position[]
  orders             Order[]
  ledger             LedgerEntry[]
}

model MarketObservation {
  id             String    @id @default(cuid())
  ingestJobId    String
  source         String
  chainId        String
  pairAddress    String
  dexId          String
  url            String?
  baseAddress    String
  baseSymbol     String
  baseName       String
  quoteAddress   String
  quoteSymbol    String
  priceUsd       Decimal?  @db.Decimal(24, 8)
  liquidityUsd   Decimal?  @db.Decimal(24, 8)
  volume24hUsd   Decimal?  @db.Decimal(24, 8)
  volume5mUsd    Decimal?  @db.Decimal(24, 8)
  priceChangeM5  Decimal?  @db.Decimal(16, 6)
  priceChangeH1  Decimal?  @db.Decimal(16, 6)
  priceChangeH24 Decimal?  @db.Decimal(16, 6)
  txnsM5Buys     Int?
  txnsM5Sells    Int?
  pairCreatedAt  DateTime?
  fdvUsd         Decimal?  @db.Decimal(24, 8)
  marketCapUsd   Decimal?  @db.Decimal(24, 8)
  freshness      String
  receivedAt     DateTime
  raw            Json
  createdAt      DateTime  @default(now())

  @@unique([ingestJobId, pairAddress])
  @@index([pairAddress, receivedAt])
  @@index([receivedAt])
}

model WatchlistEntry {
  id           String   @id @default(cuid())
  pairAddress  String
  baseAddress  String
  baseSymbol   String
  quoteAddress String
  quoteSymbol  String
  dexId        String
  source       String
  score        Decimal  @db.Decimal(16, 6)
  rank         Int
  reasonCodes  String[]
  observationId String?
  cycleId      String?
  observedAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([pairAddress])
  @@index([score, rank])
  @@index([observedAt])
}

model SecurityAssessment {
  id                         String   @id @default(cuid())
  tokenAddress               String
  category                   String
  confidence                 Decimal  @db.Decimal(8, 6)
  reasonCodes                String[]
  mintAuthority              String
  freezeAuthority            String
  transferRestricted         Boolean?
  holderConcentrationTop10Pct Decimal? @db.Decimal(16, 6)
  suspiciousDeployer         Boolean?
  liquidityFragile           Boolean?
  largeWalletMove            Boolean?
  fraudIndicators            String[]
  source                     String
  stale                      Boolean  @default(false)
  fields                     Json
  fetchedAt                  DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([tokenAddress])
  @@index([category, updatedAt])
}

model EquitySnapshot {
  id               String   @id @default(cuid())
  cycleId          String?
  cashUsd          Decimal  @db.Decimal(24, 8)
  equityUsd        Decimal? @db.Decimal(24, 8)
  unrealizedPnlUsd Decimal? @db.Decimal(24, 8)
  realizedPnlUsd   Decimal  @db.Decimal(24, 8)
  highWaterMarkUsd Decimal? @db.Decimal(24, 8)
  exposureUsd      Decimal? @db.Decimal(24, 8)
  valuation        String
  feesUsd          Decimal  @db.Decimal(24, 8)
  metrics          Json
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([cycleId])
}

model ResearchProposal {
  id              String   @id @default(cuid())
  status          String
  parameterPatch  Json
  rationale       String
  walkForward     Json?
  metrics         Json?
  promoted        Boolean  @default(false)
  modelVersion    String?
  createdAt       DateTime @default(now())
  evaluatedAt     DateTime?
  approvedAt      DateTime?

  @@index([status, createdAt])
}

/// Frozen strategy snapshot for lab comparison. Never auto-graduates to real money (no real-money venue).
model StrategyVersion {
  id        String        @id @default(cuid())
  name      String
  version   Int
  parentId  String?
  config    Json
  notes     String?
  status    String        @default("DRAFT")
  createdBy String?
  createdAt DateTime      @default(now())
  runs      BacktestRun[]

  @@unique([name, version])
  @@index([status, createdAt])
}

model BacktestRun {
  id                String               @id @default(cuid())
  strategyVersionId String?
  status            String
  label             String?
  params            Json
  assumptions       Json
  dataQuality       Json?
  metrics           Json?
  baselines         Json?
  validation        Json?
  releaseGate       Json?
  equityCurve       Json?
  reportHtml        String?
  error             String?
  startedAt         DateTime
  finishedAt        DateTime?
  createdAt         DateTime             @default(now())
  strategyVersion   StrategyVersion?     @relation(fields: [strategyVersionId], references: [id])
  trades            BacktestTrade[]
  experiments       ExperimentMetrics[]
  oracleReviews     OracleReview[]

  @@index([status, createdAt])
  @@index([strategyVersionId])
}

model BacktestTrade {
  id            String      @id @default(cuid())
  runId         String
  pairAddress   String
  baseSymbol    String
  side          String
  intent        String
  qty           Decimal     @db.Decimal(24, 8)
  priceUsd      Decimal     @db.Decimal(24, 8)
  feeUsd        Decimal     @db.Decimal(24, 8)
  slippageBps   Decimal     @db.Decimal(16, 6)
  notionalUsd   Decimal     @db.Decimal(24, 8)
  pnlUsd        Decimal?    @db.Decimal(24, 8)
  eventAt       DateTime
  observationId String?
  reasonCodes   String[]
  meta          Json?
  run           BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, eventAt])
  @@index([pairAddress, eventAt])
}

model ExperimentMetrics {
  id         String       @id @default(cuid())
  runId      String?
  proposalId String?
  kind       String
  sampleSize Int
  observed   Boolean
  payload    Json
  createdAt  DateTime     @default(now())
  run        BacktestRun? @relation(fields: [runId], references: [id])

  @@index([kind, createdAt])
  @@index([runId])
}

model ObservabilityEvent {
  id        String   @id @default(cuid())
  category  String
  name      String
  value     Decimal? @db.Decimal(24, 8)
  unit      String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([name, createdAt])
}

/// ORACLE is advisory only. Human approval required; never executes trades or mutates RUNNING config.
model OracleReview {
  id           String       @id @default(cuid())
  runId        String?
  proposalId   String?
  status       String
  summary      String
  weaknesses   Json
  suggestions  Json
  readiness    String
  provider     String
  modelVersion String?
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime     @default(now())
  run          BacktestRun? @relation(fields: [runId], references: [id])

  @@index([status, createdAt])
  @@index([runId])
}

model CycleRun {
  id               String    @id
  trigger          String
  status           String
  stage            String
  dataState        String
  error            String?
  operator         Json?
  observationCount Int       @default(0)
  orderCount       Int       @default(0)
  startedAt        DateTime
  finishedAt       DateTime?

  @@index([status, startedAt])
  @@index([startedAt])
}

model AgentDecision {
  id           String   @id @default(cuid())
  cycleId      String
  agent        String
  modelVersion String
  pairAddress  String   @default("")
  decision     String
  confidence   Decimal  @db.Decimal(8, 6)
  reasonCodes  String[]
  input        Json
  output       Json
  inputSource  String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@unique([cycleId, agent, pairAddress])
  @@index([createdAt])
  @@index([agent, createdAt])
}

model Order {
  id            String    @id @default(cuid())
  clientOrderId String    @unique
  cycleId       String
  accountId     String
  pairAddress   String
  baseSymbol    String
  side          String
  intent        String
  status        String
  qty           Decimal   @db.Decimal(24, 8)
  filledQty     Decimal   @default(0) @db.Decimal(24, 8)
  reasonCodes   String[]
  rejectReason  String?
  observationId String?
  submittedAt   DateTime  @default(now())
  eligibleAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  account       PaperAccount @relation(fields: [accountId], references: [id])
  fills         Fill[]

  @@index([createdAt])
  @@index([cycleId])
  @@index([status, eligibleAt])
}

model Fill {
  id            String   @id @default(cuid())
  orderId       String
  observationId String
  pairAddress   String
  side          String
  qty           Decimal  @db.Decimal(24, 8)
  priceUsd      Decimal  @db.Decimal(24, 8)
  notionalUsd   Decimal  @db.Decimal(24, 8)
  feeUsd        Decimal  @db.Decimal(24, 8)
  slippageBps   Decimal  @db.Decimal(16, 6)
  liquidityUsd  Decimal  @db.Decimal(24, 8)
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id])

  @@index([pairAddress, createdAt])
}

model Position {
  id             String   @id @default(cuid())
  accountId      String
  pairAddress    String
  baseSymbol     String
  baseQty        Decimal  @db.Decimal(24, 8)
  avgCostUsd     Decimal  @db.Decimal(24, 8)
  realizedPnlUsd Decimal  @db.Decimal(24, 8)
  updatedAt      DateTime @updatedAt
  account        PaperAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, pairAddress])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  accountId   String
  type        String
  amountUsd   Decimal  @db.Decimal(24, 8)
  affectsCash Boolean
  orderId     String?
  fillId      String?
  note        String
  createdAt   DateTime @default(now())
  account     PaperAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([type, createdAt])
}
