generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  createdAt    DateTime @default(now())
}

model EngineControl {
  id               String   @id @default("primary")
  status           String
  flattenRequested Boolean  @default(false)
  config           Json
  activeStrategy   Json?
  updatedAt        DateTime @updatedAt
  updatedBy        String?
}

model PaperAccount {
  id                    String         @id @default("primary")
  cashUsd               Decimal        @db.Decimal(24, 8)
  startingBalanceUsd    Decimal        @db.Decimal(24, 8)
  highWaterMarkUsd      Decimal?       @db.Decimal(24, 8)
  sessionStartEquityUsd Decimal?       @db.Decimal(24, 8)
  sessionStartedAt      DateTime?
  /// FIXTURE | REPLAY | MARKET_DATA_PAPER | EXTERNAL_DEMO — isolation boundary
  tradingEnvironment    String         @default("MARKET_DATA_PAPER")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  positions             Position[]
  orders                Order[]
  ledger                LedgerEntry[]
}

model MarketObservation {
  id             String    @id @default(cuid())
  ingestJobId    String
  source         String
  chainId        String
  pairAddress    String
  dexId          String
  url            String?
  baseAddress    String
  baseSymbol     String
  baseName       String
  quoteAddress   String
  quoteSymbol    String
  priceUsd       Decimal?  @db.Decimal(24, 8)
  liquidityUsd   Decimal?  @db.Decimal(24, 8)
  volume24hUsd   Decimal?  @db.Decimal(24, 8)
  volume5mUsd    Decimal?  @db.Decimal(24, 8)
  priceChangeM5  Decimal?  @db.Decimal(16, 6)
  priceChangeH1  Decimal?  @db.Decimal(16, 6)
  priceChangeH24 Decimal?  @db.Decimal(16, 6)
  txnsM5Buys     Int?
  txnsM5Sells    Int?
  pairCreatedAt  DateTime?
  fdvUsd         Decimal?  @db.Decimal(24, 8)
  marketCapUsd   Decimal?  @db.Decimal(24, 8)
  freshness      String
  /// LIVE_FEED | DELAYED_FEED | FIXTURE_SEQUENCE | REPLAY_STORE | PROVIDER_DEMO | SANDBOX_BROKER
  dataOrigin     String?
  /// Owning trading environment for isolation (never mix fixture into paper metrics).
  tradingEnvironment String?
  /// Provider event time when known; else null (do not invent).
  eventTime      DateTime?
  receivedAt     DateTime
  raw            Json
  createdAt      DateTime  @default(now())

  @@unique([ingestJobId, pairAddress])
  @@index([pairAddress, receivedAt])
  @@index([pairAddress, eventTime])
  @@index([tradingEnvironment, receivedAt])
  @@index([receivedAt])
}

model WatchlistEntry {
  id           String   @id @default(cuid())
  pairAddress  String
  baseAddress  String
  baseSymbol   String
  quoteAddress String
  quoteSymbol  String
  dexId        String
  source       String
  score        Decimal  @db.Decimal(16, 6)
  rank         Int
  reasonCodes  String[]
  observationId String?
  cycleId      String?
  observedAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([pairAddress])
  @@index([score, rank])
  @@index([observedAt])
}

model SecurityAssessment {
  id                         String   @id @default(cuid())
  tokenAddress               String
  category                   String
  confidence                 Decimal  @db.Decimal(8, 6)
  reasonCodes                String[]
  mintAuthority              String
  freezeAuthority            String
  transferRestricted         Boolean?
  holderConcentrationTop10Pct Decimal? @db.Decimal(16, 6)
  suspiciousDeployer         Boolean?
  liquidityFragile           Boolean?
  largeWalletMove            Boolean?
  fraudIndicators            String[]
  source                     String
  stale                      Boolean  @default(false)
  fields                     Json
  fetchedAt                  DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([tokenAddress])
  @@index([category, updatedAt])
}

model EquitySnapshot {
  id               String   @id @default(cuid())
  /// Account / environment isolation for REPLAY vs paper metrics.
  accountId        String   @default("primary")
  cycleId          String?
  cashUsd          Decimal  @db.Decimal(24, 8)
  equityUsd        Decimal? @db.Decimal(24, 8)
  unrealizedPnlUsd Decimal? @db.Decimal(24, 8)
  realizedPnlUsd   Decimal  @db.Decimal(24, 8)
  highWaterMarkUsd Decimal? @db.Decimal(24, 8)
  exposureUsd      Decimal? @db.Decimal(24, 8)
  valuation        String
  feesUsd          Decimal  @db.Decimal(24, 8)
  metrics          Json
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([cycleId])
  @@index([accountId, createdAt])
}

model ResearchProposal {
  id              String   @id @default(cuid())
  status          String
  parameterPatch  Json
  rationale       String
  walkForward     Json?
  metrics         Json?
  promoted        Boolean  @default(false)
  modelVersion    String?
  createdAt       DateTime @default(now())
  evaluatedAt     DateTime?
  approvedAt      DateTime?

  @@index([status, createdAt])
}

/// Frozen strategy snapshot for lab comparison. Never auto-graduates to real money (no real-money venue).
model StrategyVersion {
  id        String        @id @default(cuid())
  name      String
  version   Int
  parentId  String?
  config    Json
  notes     String?
  status    String        @default("DRAFT")
  createdBy String?
  createdAt DateTime      @default(now())
  runs      BacktestRun[]

  @@unique([name, version])
  @@index([status, createdAt])
}

model BacktestRun {
  id                String               @id @default(cuid())
  strategyVersionId String?
  status            String
  label             String?
  params            Json
  assumptions       Json
  dataQuality       Json?
  metrics           Json?
  baselines         Json?
  validation        Json?
  releaseGate       Json?
  equityCurve       Json?
  reportHtml        String?
  error             String?
  startedAt         DateTime
  finishedAt        DateTime?
  createdAt         DateTime             @default(now())
  strategyVersion   StrategyVersion?     @relation(fields: [strategyVersionId], references: [id])
  trades            BacktestTrade[]
  experiments       ExperimentMetrics[]
  oracleReviews     OracleReview[]

  @@index([status, createdAt])
  @@index([strategyVersionId])
}

model BacktestTrade {
  id            String      @id @default(cuid())
  runId         String
  pairAddress   String
  baseSymbol    String
  side          String
  intent        String
  qty           Decimal     @db.Decimal(24, 8)
  priceUsd      Decimal     @db.Decimal(24, 8)
  feeUsd        Decimal     @db.Decimal(24, 8)
  slippageBps   Decimal     @db.Decimal(16, 6)
  notionalUsd   Decimal     @db.Decimal(24, 8)
  pnlUsd        Decimal?    @db.Decimal(24, 8)
  eventAt       DateTime
  observationId String?
  reasonCodes   String[]
  meta          Json?
  run           BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, eventAt])
  @@index([pairAddress, eventAt])
}

model ExperimentMetrics {
  id         String       @id @default(cuid())
  runId      String?
  proposalId String?
  kind       String
  sampleSize Int
  observed   Boolean
  payload    Json
  createdAt  DateTime     @default(now())
  run        BacktestRun? @relation(fields: [runId], references: [id])

  @@index([kind, createdAt])
  @@index([runId])
}

model ObservabilityEvent {
  id        String   @id @default(cuid())
  category  String
  name      String
  value     Decimal? @db.Decimal(24, 8)
  unit      String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([category, createdAt])
  @@index([name, createdAt])
}

/// ORACLE is advisory only. Human approval required; never executes trades or mutates RUNNING config.
model OracleReview {
  id           String       @id @default(cuid())
  runId        String?
  proposalId   String?
  status       String
  summary      String
  weaknesses   Json
  suggestions  Json
  readiness    String
  provider     String
  modelVersion String?
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime     @default(now())
  run          BacktestRun? @relation(fields: [runId], references: [id])

  @@index([status, createdAt])
  @@index([runId])
}

model CycleRun {
  id               String    @id
  trigger          String
  status           String
  stage            String
  dataState        String
  error            String?
  operator         Json?
  observationCount Int       @default(0)
  orderCount       Int       @default(0)
  startedAt        DateTime
  finishedAt       DateTime?

  @@index([status, startedAt])
  @@index([startedAt])
}

model AgentDecision {
  id           String   @id @default(cuid())
  cycleId      String
  agent        String
  modelVersion String
  pairAddress  String   @default("")
  decision     String
  confidence   Decimal  @db.Decimal(8, 6)
  reasonCodes  String[]
  input        Json
  output       Json
  inputSource  String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@unique([cycleId, agent, pairAddress])
  @@index([createdAt])
  @@index([agent, createdAt])
}

model Order {
  id              String    @id @default(cuid())
  clientOrderId   String    @unique
  cycleId         String
  accountId       String
  pairAddress     String
  baseSymbol      String
  side            String
  intent          String
  status          String
  qty             Decimal   @db.Decimal(24, 8)
  filledQty       Decimal   @default(0) @db.Decimal(24, 8)
  reasonCodes     String[]
  rejectReason    String?
  /// Observation that informed the admission decision (may predate eligibility).
  observationId   String?
  decisionObservationId String?
  /// Observation used for the economic fill (at/after eligibility).
  fillObservationId String?
  executionMode   String    @default("PAPER")
  venue           String    @default("PAPER")
  instrumentId    String?
  strategyVersion String?
  submittedAt     DateTime  @default(now())
  eligibleAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  account         PaperAccount @relation(fields: [accountId], references: [id])
  fills           Fill[]

  @@index([createdAt])
  @@index([cycleId])
  @@index([status, eligibleAt])
  @@index([executionMode, venue])
}

model Fill {
  id            String   @id @default(cuid())
  orderId       String
  observationId String
  pairAddress   String
  side          String
  qty           Decimal  @db.Decimal(24, 8)
  priceUsd      Decimal  @db.Decimal(24, 8)
  notionalUsd   Decimal  @db.Decimal(24, 8)
  feeUsd        Decimal  @db.Decimal(24, 8)
  slippageBps   Decimal  @db.Decimal(16, 6)
  liquidityUsd  Decimal  @db.Decimal(24, 8)
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id])

  @@index([pairAddress, createdAt])
}

model Position {
  id             String   @id @default(cuid())
  accountId      String
  pairAddress    String
  baseSymbol     String
  baseQty        Decimal  @db.Decimal(24, 8)
  avgCostUsd     Decimal  @db.Decimal(24, 8)
  realizedPnlUsd Decimal  @db.Decimal(24, 8)
  /// Current open-lot id; minted on 0→open, cleared on flat. Scopes protection + open meta (R01).
  lifecycleId    String?
  updatedAt      DateTime @updatedAt
  account        PaperAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, pairAddress])
  @@index([accountId, lifecycleId])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  accountId   String
  type        String
  amountUsd   Decimal  @db.Decimal(24, 8)
  affectsCash Boolean
  orderId     String?
  fillId      String?
  note        String
  createdAt   DateTime @default(now())
  account     PaperAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([type, createdAt])
}

/// Multi-market instrument registry (Solana pairs + equity indices, etc.).
model Instrument {
  id                     String   @id
  symbol                 String
  displayName            String
  venue                  String
  assetClass             String
  base                   String
  quote                  String
  tickSize               String
  lotSize                String
  session                String
  providerId             String
  providerSymbol         String
  executionCapabilities  String[]
  enabledByDefault       Boolean  @default(false)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  selections             MarketSelection[]

  @@index([assetClass, venue])
  @@index([providerId])
}

model MarketSelection {
  id           String     @id @default(cuid())
  instrumentId String
  enabled      Boolean
  updatedBy    String?
  updatedAt    DateTime   @updatedAt
  instrument   Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([instrumentId])
}

model Hypothesis {
  id               String   @id @default(cuid())
  title            String
  market           String
  instrumentIds    String[]
  conditions       String
  claimedAdvantage String
  entryRules       String
  exitRules        String
  riskRules        String
  rationale        String
  successCriteria  String
  failureModes     String
  status           String   @default("OPEN")
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
  @@index([market])
}

model LifecycleAudit {
  id           String   @id @default(cuid())
  strategyId   String
  fromState    String
  toState      String
  actor        String
  evidence     Json
  evidenceHash String
  createdAt    DateTime @default(now())

  @@index([strategyId, createdAt])
  @@index([toState, createdAt])
}

model ExperimentReport {
  id              String   @id @default(cuid())
  hypothesisId    String
  strategyModuleId String
  strategyVersion String
  payload         Json
  contentHash     String
  signature       String
  approvalStatus  String   @default("PENDING")
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([hypothesisId, createdAt])
  @@index([contentHash])
}

model TradeMemory {
  id          String   @id @default(cuid())
  tradeId     String
  pairAddress String
  phase       String
  postExit    Boolean  @default(false)
  context     Json
  capturedAt  DateTime
  createdAt   DateTime @default(now())

  @@index([tradeId, phase])
  @@index([pairAddress, capturedAt])
  @@index([postExit, capturedAt])
}

model ModelUsageLog {
  id                  String   @id @default(cuid())
  agentOrTask         String
  endpointId          String
  provider            String
  model               String
  tier                String
  ok                  Boolean
  latencyMs           Int
  promptTokensEst     Int
  completionTokensEst Int
  costUsdEst          Decimal  @db.Decimal(16, 8)
  costKind            String   @default("ESTIMATED")
  provenance          String   @default("UNAVAILABLE")
  error               String?
  createdAt           DateTime @default(now())

  @@index([agentOrTask, createdAt])
  @@index([tier, createdAt])
}

model ResearchQueueItem {
  id           String   @id @default(cuid())
  kind         String
  priority     Int
  hypothesisId String?
  strategyId   String?
  status       String
  reason       String
  budgetUsd    Decimal  @db.Decimal(16, 8)
  fingerprint  String   @default("")
  retries      Int      @default(0)
  capability   String   @default("RECOMMEND_EXPERIMENT")
  provenance   String   @default("DETERMINISTIC_SUPERVISOR")
  aiDiscovery  Boolean  @default(false)
  failureStreak Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, priority])
  @@index([createdAt])
}

model AutonomyControl {
  id                         String   @id @default("primary")
  level                      Int      @default(1)
  realMoneyExecutionEnabled  Boolean  @default(false)
  allowUnreviewedCodeDeploy  Boolean  @default(false)
  allowRiskLimitMutation     Boolean  @default(false)
  maxResearchIterations      Int      @default(8)
  maxResearchBudgetUsd       Decimal  @db.Decimal(16, 8) @default(5)
  timeoutMs                  Int      @default(120000)
  updatedAt                  DateTime @updatedAt
  updatedBy                  String?
}

model RiskReservation {
  id                     String   @id @default(cuid())
  accountId              String
  mode                   String   @default("PAPER")
  clientOrderId          String
  status                 String
  cashUsd                Decimal  @db.Decimal(24, 8)
  exposureUsd            Decimal  @db.Decimal(24, 8)
  slots                  Int
  riskUsd                Decimal  @db.Decimal(24, 8)
  remainingCashUsd       Decimal  @db.Decimal(24, 8) @default(0)
  remainingExposureUsd   Decimal  @db.Decimal(24, 8) @default(0)
  remainingRiskUsd       Decimal  @db.Decimal(24, 8) @default(0)
  remainingSlots         Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  events                 RiskReservationEvent[]

  @@unique([accountId, mode, clientOrderId])
  @@index([accountId, status])
}

model RiskReservationEvent {
  id            String   @id @default(cuid())
  reservationId String
  accountId     String
  mode          String
  clientOrderId String
  type          String
  payload       Json
  createdAt     DateTime @default(now())
  reservation   RiskReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([reservationId, createdAt])
}

model ProtectionOrder {
  id                       String   @id @default(cuid())
  accountId                String
  positionKey              String
  ocoGroupId               String
  /// Open-lot lifecycle this protection covers (R01).
  lifecycleId              String?
  kind                     String
  origin                   String
  direction                String   @default("LONG")
  protectedQty             Decimal  @db.Decimal(24, 8) @default(0)
  remainingQty             Decimal  @db.Decimal(24, 8) @default(0)
  triggerPriceUsd          Decimal? @db.Decimal(24, 8)
  /// Last confirmed (acked) trigger — retained when amendment fails.
  confirmedTriggerPriceUsd Decimal? @db.Decimal(24, 8)
  /// Desired trigger during amend/submit (may diverge until ACK).
  desiredTriggerPriceUsd   Decimal? @db.Decimal(24, 8)
  trailPct                 Decimal? @db.Decimal(16, 6)
  extremePriceUsd          Decimal? @db.Decimal(24, 8)
  status                   String
  /// DESIRED_ONLY | SUBMITTED | ACKED | REJECTED | CANCELLED | UNKNOWN
  ackState                 String   @default("ACKED")
  claimWorkerId            String?
  strategyInstanceId       String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([ocoGroupId])
  @@index([positionKey, status])
  @@index([lifecycleId, status])
  @@index([status, updatedAt])
  @@index([accountId, status])
}

model ProtectionIntent {
  id          String    @id @default(cuid())
  accountId   String
  ocoGroupId  String
  legId       String
  status      String
  reason      String
  attempts    Int       @default(0)
  retryAfter  DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, retryAfter])
  @@index([ocoGroupId])
}

model StrategyInstance {
  id              String   @id @default(cuid())
  name            String
  version         String
  accountId       String
  instrumentIds   String[]
  timeframe       String   @default("M5")
  params          Json
  budgetUsd       Decimal  @db.Decimal(24, 8)
  health          String   @default("HEALTHY")
  status          String   @default("ACTIVE")
  artifactHash    String?
  sourceHash      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, status])
  @@index([status, updatedAt])
}

model OpportunityFunnelEvent {
  id           String   @id @default(cuid())
  /// Account / environment isolation — REPLAY funnel must not mix into paper.
  accountId    String   @default("primary")
  cycleId      String
  pairAddress  String
  instrumentId String?
  stage        String
  reasonCodes  String[]
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([cycleId])
  @@index([stage, createdAt])
  @@index([accountId, createdAt])
}

model DurableAlert {
  id        String    @id @default(cuid())
  /// Optional account scope — notifications only; does not own safety resolution (R06).
  accountId String?
  severity  String    @default("INFO")
  code      String
  message   String
  acked     Boolean   @default(false)
  payload   Json?
  createdAt DateTime  @default(now())
  ackedAt   DateTime?

  @@index([acked, createdAt])
  @@index([accountId, acked, createdAt])
}

/// Active safety controls independent of DurableAlert.acked (R06).
/// ACK of an alert never resolves these — only clean reconcile / explicit resolve path.
model AccountSafetyState {
  id          String    @id @default(cuid())
  accountId   String
  code        String
  /// ACTIVE | RESOLVED
  status      String
  detail      Json?
  activatedAt DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([accountId, code])
  @@index([accountId, status])
}
