+/**
+ * PCR-1: the lot stamp for a SELL booked now. Called only inside the account-locked transaction that writes
+ * the order, so it is exactly the position the order was decided against. BUYs and flat pairs get nulls.
+ */
+async function currentLotStamp(
+  tx: Prisma.TransactionClient,
+  accountId: string,
+  pairAddress: string,
+  side: "BUY" | "SELL",
+): Promise<{ positionLifecycleId: string | null; positionBoughtQtyAtBooking: string | null }> {
+  if (side !== "SELL") return { positionLifecycleId: null, positionBoughtQtyAtBooking: null };
+  const position = await tx.position.findUnique({ where: { accountId_pairAddress: { accountId, pairAddress } } });
+  const stamp = exitStampFor(
+    position
+      ? { qty: position.baseQty.toString(), lotId: position.lifecycleId, cumBoughtQty: position.cumBoughtQty.toString() }
+      : null,
+  );
+  return { positionLifecycleId: stamp.lotId, positionBoughtQtyAtBooking: stamp.boughtQtyAtBooking };
+}
+
+/**
+ * PCR-1: change to Position.cumBoughtQty for a fill. Only BUY fills move the monotonic counter; it is applied
+ * in the same upsert (same transaction) that applies the fill to the position.
+ */
+function boughtDelta(side: string, qty: string): string {
+  return side === "BUY" ? d(qty).toFixed(8) : "0";
+}
