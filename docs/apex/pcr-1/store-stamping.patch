+/**
+ * PCR-1: booking stamps for an order written now. Called only inside the account-locked transaction that
+ * writes the order, so they describe exactly the position (and, for STRATEGY, the owner's allocation) the
+ * order was decided against. BUYs and flat pairs get nulls.
+ */
+async function currentLotStamp(
+  tx: Prisma.TransactionClient,
+  accountId: string,
+  order: Pick<CommitOrder, "pairAddress" | "side" | "ownerScope" | "strategyInstanceId">,
+): Promise<{ positionLifecycleId: string | null; positionBoughtQtyAtBooking: string | null; allocationBoughtQtyAtBooking: string | null }> {
+  const none = { positionLifecycleId: null, positionBoughtQtyAtBooking: null, allocationBoughtQtyAtBooking: null };
+  if (order.side !== "SELL") return none;
+  const position = await tx.position.findUnique({ where: { accountId_pairAddress: { accountId, pairAddress: order.pairAddress } } });
+  const allocation =
+    order.ownerScope === "STRATEGY" && order.strategyInstanceId
+      ? await tx.strategyAllocation.findUnique({
+          where: { accountId_strategyInstanceId_pairAddress: { accountId, strategyInstanceId: order.strategyInstanceId, pairAddress: order.pairAddress } },
+        })
+      : null;
+  const stamp = exitStampFor(
+    position ? { qty: position.baseQty.toString(), lotId: position.lifecycleId, cumBoughtQty: position.cumBoughtQty.toString() } : null,
+    allocation ? { qty: allocation.qty.toString(), cumBoughtQty: allocation.cumBoughtQty.toString() } : null,
+  );
+  return {
+    positionLifecycleId: stamp.lotId,
+    positionBoughtQtyAtBooking: stamp.boughtQtyAtBooking,
+    allocationBoughtQtyAtBooking: stamp.allocationBoughtQtyAtBooking ?? null,
+  };
+}
+
+/**
+ * PCR-1: change to Position.cumBoughtQty for a fill. Only BUY fills move the monotonic counter; it is applied
+ * in the same upsert (same transaction) that applies the fill to the position.
+ */
+function boughtDelta(side: string, qty: string): string {
+  return side === "BUY" ? d(qty).toFixed(8) : "0";
+}
