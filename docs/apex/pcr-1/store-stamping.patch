+/**
+ * The open lot a SELL is booked against (PCR-1). Read inside the account-locked transaction, so it is the
+ * lot the order was decided for. Null when the pair is flat (the F5 EXIT_SUPERSEDED guard covers that).
+ */
+async function currentLotId(tx: Prisma.TransactionClient, accountId: string, pairAddress: string): Promise<string | null> {
+  const position = await tx.position.findUnique({ where: { accountId_pairAddress: { accountId, pairAddress } } });
+  return position && d(position.baseQty.toString()).gt(0) ? position.lifecycleId : null;
+}
