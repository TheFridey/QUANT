# Local paper-trading defaults. Change JWT_SECRET and ADMIN_PASSWORD before any shared deployment.
# Production boot refuses these sample secrets when NODE_ENV=production.
# Scope: single-operator local/VPN paper (see docs/RUNBOOKS.md). Not multi-user auth.
# Changing ADMIN_PASSWORD here does NOT rotate an already-seeded user hash (bootstrap create-only).

DATABASE_URL=postgresql://odin:odin@127.0.0.1:5432/odin
DATABASE_URL_TEST=postgresql://odin:odin@127.0.0.1:5432/odin_test
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@odin.local
ADMIN_PASSWORD=odin-paper-dev

WEB_ORIGIN=http://127.0.0.1:4317
API_PORT=4318
# API and web listen on 127.0.0.1 by default. Widen deliberately (e.g. 0.0.0.0 inside a container
# behind a reverse proxy). When WEB_ORIGIN is not loopback, the API refuses sample secrets and a
# JWT_SECRET shorter than 32 characters, whatever NODE_ENV says.
# API_HOST=127.0.0.1
# WEB_HOST=127.0.0.1
NEXT_PUBLIC_API_URL=http://127.0.0.1:4318

# live | replay | demo
# demo does not synthesize prices. replay relabels stored observations and does not trade.
DATA_MODE=live
MARKET_POLL_MS=20000

# Optional. Historical candles, token security, and holder stats.
BIRDEYE_API_KEY=

# Optional. Advisory-only LLM. Without a key the mock provider is used offline.
OPENAI_API_KEY=
# Optional Hermes-compatible OpenAI chat endpoint.
HERMES_BASE_URL=
HERMES_API_KEY=

# Execution mode: PAPER (default) | SANDBOX | LIVE
# LIVE is refused unless LIVE_MONEY_ENABLED=true AND LIVE_MONEY_CONFIRM=I_UNDERSTAND_LIVE_RISK
# — and even then this MVP has no live broker route.
EXECUTION_MODE=PAPER
LIVE_MONEY_ENABLED=false
# LIVE_MONEY_CONFIRM=

# Legacy generic key — does NOT unlock named providers by itself.
EXTERNAL_DEMO_API_KEY=
# EXTERNAL_DEMO_BASE_URL=

# Named external demo providers (see docs/mvp/PROVIDER_CAPABILITIES.md).
# Alpaca paper (US ETF/equity paper). Practice host only.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# OANDA fxTrade Practice (FX). Practice host only.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# OANDA_API_URL=https://api-fxpractice.oanda.com
